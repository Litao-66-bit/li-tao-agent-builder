# 密钥与本地配置（绝不入库）
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# 虚拟环境
.venv/
venv/
env/

# 测试与 lint 缓存
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# 项目注册表（含本机绝对路径，绝不入库）
data/projects.json
data/*.json.tmp

# 运行时状态（记忆 / 审计，落在当前工作区内）
.agent-memory/
.agent-audit/
.agent-tmp/

# agent 产物输出根目录（见 agent_builder/tools/gatekeeper.py: OUTPUT_ROOT_DIRNAME）
outputs/

# DSH 插件启用的沙箱与回滚备份（含本机绝对路径，绝不入库）
.dsh-scratch/

# 本地依赖目录（pip install --target .deps 的依赖树）与实测产物草稿目录
# —— 都不是项目源码，推送时不该带上（ruff 的 exclude 里也排除了这两处）
.deps/
_sample_backup/

# ── 本机运行时 / 实测产物（含本机绝对路径，绝不入库；ruff check . 也才不会被它们拖红）──
# DSH 沙箱 ACL 审计报告（插件生成，含本机绝对路径）
.dsh-acl-reports/
# 旧的沙箱配方留下的临时测试根目录（会污染 ruff check . 与 pytest 收集）
pytest-root/
# 落错位置的运行时数据：项目注册表副本 / 一次任务的工作区 / agent 的实测小产物
paper-agent-registry/
agent-workbench/
paper-agent-demo/
# 上面那条实测产物的直接输出文件
/result.txt

